# ===== 後端環境變數設定 =====
# 開發期：
# 1. 將此檔案複製到 backend/.env
# 2. 在 backend/ 執行 npm run dev 啟動後端
# 3. PostgreSQL 資料庫在 Docker，這時的 DB_HOST 是使用 localhost
#
# 容器化後：
# backend 的環境變數變成由 docker-compose.yml 設定；
# 容器內連線 PostgreSQL 時，DB_HOST 應設為 postgres。（後續到容器化步驟時，就會比較理解這個部分）

PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=student
DB_PASSWORD=student666
DB_DATABASE=fitness

JWT_SECRET=請換成你自己的亂數字串
JWT_EXPIRES_DAY=30d

# 下面兩個是給「用課堂 TypeORM 寫法」的人：CI 驗收時也會帶這兩個值
# 想練 W8 教的 migration：把 DB_SYNCHRONIZE 改成 false，改用 npm run migration:run 建表
# （CI 仍然會帶 true，所以走哪條路驗收都不受影響）
DB_SYNCHRONIZE=true
DB_ENABLE_SSL=false

# 加分題:根據ai開發進化營的加碼課程，使用cloudflare r2上傳
# 從 Cloudflare Account ID 取得
R2_ACCOUNT_ID=你的帳戶ID
# Token 建立完成頁面的第 2 個
R2_ACCESS_KEY_ID=存取金鑰識別碼
# Token 建立完成頁面的第 3 個
R2_SECRET_ACCESS_KEY=秘密存取金鑰
# 儲存的bucket名稱
R2_BUCKET_NAME=node-js-final-use
# 到你建立的bucket開啟開發預覽，得到的公開網址
R2_PUBLIC_BASE_URL=https://pub-隨機識別碼.r2.dev

# 測試上傳成功的圖片
# https://pub-f236fd6030f24d079bd37b866173a1f1.r2.dev/images/a4d900d4-8437-4bd2-9022-af04185cbaa1/f3c065ea-bbec-419f-b9f3-8e75130ebbcc.jpg